ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://custom-endpoint.example.com
MEM0_API_KEY=your-mem0-api-key

# Personality: default, philosopher, creative, clara, rumi (or path via PERSONALITY_FILE)
PERSONALITY_NAME=default

# Timing & Context
THOUGHT_INTERVAL=60
MAX_TOKENS=1024
MAX_HISTORY=10

# Discord (optional) - create webhook in channel settings
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# === Attention layer (LIDA-inspired; see docs/attention.md) ===
# off = legacy behaviour (default) · observe = log decisions only · active = apply them
ATTENTION_MODE=off
ATTENTION_DUPLICATE_WINDOW=5
ATTENTION_DEFERRAL_THRESHOLD=2
ATTENTION_IDLE_BACKOFF_SECONDS=120
ATTENTION_MAX_CONSECUTIVE_REDIRECTS=1
ATTENTION_LOG_PATH=./logs/attention.jsonl
ATTENTION_RANDOM_SEED=7
# Hard budgets (0 = unlimited); create this file to suspend an active run:
# ATTENTION_MAX_CYCLES=0
# ATTENTION_MAX_APPROX_TOKENS=0
# ATTENTION_STOP_FILE=./logs/STOP

# === Baseline / benchmark harness ===
# RUN_MAX_THOUGHTS=0
# RUN_MAX_SECONDS=0
# RUN_RECORD=false              # per-cycle record in logs/runs/
# BENCHMARK_MODE=false          # hide update_source/restart_self/add|remove_mcp_server; implies RUN_RECORD
# HISTORY_TOKEN_BUDGET=0        # trim context history by ~tokens instead of MAX_HISTORY only
# LLM_TEMPERATURE=              # unset = provider default
