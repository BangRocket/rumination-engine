{
  "mcpServers": {
    "mem0": {
      "command": "uvx",
      "args": [
        "mem0-mcp-server"
      ],
      "env": {
        "MEM0_API_KEY": "${MEM0_API_KEY}",
        "MEM0_DEFAULT_USER_ID": "${IDENTITY}"
      }
    },
    "package-registry": {
      "command": "npx",
      "args": [
        "-y",
        "package-registry-mcp"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/workspace",
        "/opt/rumination-engine"
      ]
    }
  }
}
